[Unit]
Description=Nightly dylt build — trigger GHA nightly release workflow

[Service]
Type=oneshot
User=rayray
WorkingDirectory=/opt/svc/nightly-release/dylt-dev-dylt
EnvironmentFile=/opt/svc/nightly-release/dylt-dev-dylt/env
ExecStart=/opt/svc/nightly-release/dylt-dev-dylt/bin/run.sh

[Install]
WantedBy=multi-user.target
